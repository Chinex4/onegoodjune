NEXT_PUBLIC_SITE_URL=https://onegoodjune.com
# Social profiles (defaults to the client's profiles when blank).
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
# Sanity (project 9xcfqdcp). Server-only credentials must never use NEXT_PUBLIC_ prefixes.
NEXT_PUBLIC_SANITY_PROJECT_ID=9xcfqdcp
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token from project 9xcfqdcp; only used for draft preview.
SANITY_API_READ_TOKEN=
SANITY_PREVIEW_SECRET=
# Contact form email (Resend).
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=sayhi@onegoodjune.com
# Shared limiter required for production contact delivery.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
CONTACT_TRUST_PROXY=false
# Program registrations and payments — see docs/PAYMENTS-SETUP.md.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Optional Paystack plan codes: when set, checkout starts a recurring subscription.
PAYSTACK_PLAN_SOG_RISER=
PAYSTACK_PLAN_SOG_BUILDER=
PAYSTACK_PLAN_SOG_VISIONARY=
MONGODB_URI=
MONGODB_DB=onegoodjune
# Admin dashboard at /admin.
ADMIN_PASSWORD=
# At least 32 random characters, e.g. `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=
